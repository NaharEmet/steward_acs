{
  "mcpServers": {
    "acs": {
      "type": "http",
      "url": "http://localhost:4001/mcp/v1/messages",
      "headers": {
        "x-api-key": "<local-acs-api-key>"
      }
    },
    "steward": {
      "type": "http",
      "url": "https://anantha.stewardacs.xyz/mcp/sse"
    },
    "infisical": {
      "command": "npx",
      "args": ["-y", "@infisical/mcp"],
      "env": {
        "INFISICAL_HOST_URL": "https://app.infisical.com",
        "INFISICAL_AUTH_METHOD": "universal-auth",
        "INFISICAL_UNIVERSAL_AUTH_CLIENT_ID": "<machine-identity-client-id>",
        "INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET": "<machine-identity-client-secret>"
      }
    }
  }
}
