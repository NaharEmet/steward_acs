# Multi-tenant prod — NON-SECRET config only (thin host .env).
#
# Secrets live in Infisical project steward_prod / env prod.
# Deploy uses: ./scripts/infisical-compose.sh -f docker-compose.multitenant.yml …
#
# On the server also create .infisical.env (mode 600) with the read-only
# machine identity (INFISICAL_UNIVERSAL_AUTH_CLIENT_ID / _SECRET).
#
# Local development: ignore this file — use .env.example → .env instead.

BASE_DOMAIN=stewardacs.xyz
PHX_HOST=prod.stewardacs.xyz
ACCOUNT_HOST=prod.stewardacs.xyz
OIDC_BROWSER_ENABLED=true
AUTH0_WEB_REDIRECT_URI=https://prod.stewardacs.xyz/auth/callback
SELF_SERVICE_ORGS_ENABLED=true
ACS_ORG_NAME=default
ACS_IMAGE_TAG=multitenant

# MCP / OAuth public URLs (non-secret)
MCP_PUBLIC_URL=https://prod.stewardacs.xyz
MCP_RESOURCE_URL=https://prod.stewardacs.xyz/mcp/sse
AUTH0_DOMAIN=dev-jw5wgp2b.us.auth0.com
AUTH0_AUDIENCE=https://prod.stewardacs.xyz/mcp/sse
AUTH0_AUDIENCE_URLENC=https%3A%2F%2Fprod.stewardacs.xyz%2Fmcp%2Fsse
AUTH0_CONNECTION=email

# Neon SSL / pool (non-secret; DATABASE_URL itself is in Infisical)
PGSSL=true
POOL_SIZE=10

# Observability dataset name (token AXIOM_LOGS is in Infisical)
AXIOM_DATASET=steward-acs
AXIOM_METRICS_DATASET=steward-acs-metrics
# Prefer your Axiom edge URL for OTLP (hostmetrics + app traces).
# AXIOM_DOMAIN=https://us-east-1.aws.edge.axiom.co
# Enable otel_collector hostmetrics sidecar in docker compose.
COMPOSE_PROFILES=axiom

# Optional flags
# OAUTH_BEARER_ENABLED=false
# MCP_QUERY_KEY_AUTH=false
# OAUTH_FIXED_DCR_CLIENT_ID=
